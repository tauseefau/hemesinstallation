# ElevenLabs MCP Server - environment configuration
# Copy this file to .env and fill in your values. NEVER commit the real .env.

# Your ElevenLabs API key (from the ElevenLabs Dashboard, and mirrored in Bitwarden Secrets Manager)
# ELEVENLABS_API_KEY=el_...

# Optional: override the ElevenLabs API base URL (defaults to https://api.elevenlabs.io/v1)
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1

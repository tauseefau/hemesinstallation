# VAPI MCP Server — environment configuration
# Copy this file to .env and fill in your values. NEVER commit the real .env.

# Your Vapi API key (from the Vapi Dashboard, and mirrored in Bitwarden Secrets Manager)
# VAPI_API_KEY=sk-vapi-...

# Optional: override the Vapi API base URL (defaults to https://api.vapi.ai)
# VAPI_BASE_URL=https://api.vapi.ai

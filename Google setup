Appendix C — Preflight script
File: scripts/install-google-auth.sh

#!/bin/sh
# install-google-auth.sh — make the Hermes google-workspace skill runnable.
#
# Creates $HERMES_HOME/google-workspace-venv with the pinned Google API deps and
# writes $HERMES_HOME/bin/{gsetup,gapi} wrappers that always exec that venv.
# Idempotent: safe to re-run at any time.
#
# Why a venv: the skill pins google-auth==2.55.1 (Python >= 3.10). Machines whose
# only interpreter is 3.8/3.9 cannot install the pins at all, and calling setup.py
# with a bare `python3` silently targets the wrong interpreter.
set -eu

HERMES_HOME="${HERMES_HOME:-$HOME/.hermes}"
SKILL_DIR="$HERMES_HOME/skills/productivity/google-workspace"
SETUP="$SKILL_DIR/scripts/setup.py"
API="$SKILL_DIR/scripts/google_api.py"
VENV="$HERMES_HOME/google-workspace-venv"
BIN="$HERMES_HOME/bin"
UV="$HERMES_HOME/bin/uv"

if [ ! -f "$SETUP" ]; then
  echo "ERROR: $SETUP not found. Install the google-workspace skill first." >&2
  exit 1
fi

# --- 1. pick a Python >= 3.10 ------------------------------------------------
PY=""
for cand in python3.13 python3.12 python3.11 python3.10; do
  if command -v "$cand" >/dev/null 2>&1; then PY="$(command -v "$cand")"; break; fi
done

if [ -z "$PY" ] && [ -x "$UV" ]; then
  echo "No interpreter >= 3.10 on PATH; asking uv to provide one."
  "$UV" python install 3.12 >/dev/null 2>&1 || true
  for cand in python3.12 python3.13 python3.11 python3.10; do
    if command -v "$cand" >/dev/null 2>&1; then PY="$(command -v "$cand")"; break; fi
  done
fi

if [ -z "$PY" ]; then
  echo "ERROR: need Python >= 3.10 (3.10-3.13). Install one, or install uv at" >&2
  echo "       $UV so this script can fetch an interpreter." >&2
  exit 1
fi
echo "Using interpreter: $PY ($("$PY" -V 2>&1))"

# --- 2. venv -----------------------------------------------------------------
if [ -x "$VENV/bin/python" ]; then
  echo "Venv already present: $VENV"
elif [ -x "$UV" ]; then
  "$UV" venv --python "$PY" "$VENV"
else
  "$PY" -m venv "$VENV"
fi

# --- 3. deps (pins come from setup.py, so they cannot drift) -----------------
echo "Installing pinned Google deps..."
if ! "$VENV/bin/python" "$SETUP" --install-deps; then
  echo "ERROR: dependency install failed. Retry manually:" >&2
  echo "  $UV pip install --python $VENV/bin/python google-api-python-client==2.194.0 google-auth==2.55.1 google-auth-oauthlib==1.3.1 google-auth-httplib2==0.3.1 httplib2==0.32.0 pyasn1==0.6.4" >&2
  exit 1
fi

echo "Checking imports..."
"$VENV/bin/python" -c 'import google.oauth2.credentials, google_auth_oauthlib.flow, googleapiclient.discovery' \
  && echo "  imports OK"

# --- 4. wrappers -------------------------------------------------------------
mkdir -p "$BIN"
cat > "$BIN/gsetup" <<EOF
#!/bin/sh
exec "$VENV/bin/python" "$SETUP" "\$@"
EOF
cat > "$BIN/gapi" <<EOF
#!/bin/sh
exec "$VENV/bin/python" "$API" "\$@"
EOF
chmod 755 "$BIN/gsetup" "$BIN/gapi"
echo "Wrappers: $BIN/gsetup, $BIN/gapi"

case ":$PATH:" in
  *":$BIN:"*) : ;;
  *) echo "NOTE: $BIN is not on PATH — call the wrappers by absolute path." ;;
esac

# --- 5. report ---------------------------------------------------------------
echo "--- auth status ---"
"$BIN/gsetup" --check || echo "(expected until OAuth is completed — see SKILL.md Step 2 onward)"
